{
  "title": "MiniMax H3 — Video + Audio",
  "description": "MiniMax H3 on ComfyUI (CUDA 13): text / image / first-last-frame / reference-to-video with audio. The RunPod Dockerfile bakes the complete H3 model set into the image; no model volume is required.",
  "type": "serverless",
  "category": "video",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 30,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80,BLACKWELL_96",
    "allowedCudaVersions": [
      "13.0"
    ],
    "env": [
      {
        "key": "H3_TEMPLATE_SET",
        "input": {
          "name": "默认模板集",
          "type": "string",
          "description": "native（原生）或 enhancers（增强）",
          "default": "native",
          "advanced": true
        }
      },
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "Hugging Face token",
          "type": "string",
          "description": "仅拉取 gated 仓库时需要",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "JOB_TIMEOUT_S",
        "input": {
          "name": "单任务超时（秒）",
          "type": "number",
          "description": "超过该时间未完成的任务会被中断",
          "min": 60,
          "max": 7200,
          "default": 1800,
          "advanced": true
        }
      }
    ]
  }
}
