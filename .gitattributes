# Keep every text file LF in the repository and in the working tree: the image
# runs shell scripts directly, and a CRLF shebang (#!/bin/bash\r) makes the
# container die instantly with "No such file or directory".
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.mjs  text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
